{
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.28",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.6",
    "express": "^5.3.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^1.0.0-rc.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
